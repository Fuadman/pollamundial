# Google OAuth (obtén estos de Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Secret (genera una clave aleatoria)
JWT_SECRET=tu_jwt_secret_key_aleatorio

# Database (ya configurado por defecto)
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=copa_prediction

# API Port
API_PORT=3000
