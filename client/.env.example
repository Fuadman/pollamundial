# Backend API base URL
# Local: leave empty to use Vite proxy/local same-origin calls
# Render example: https://pollamundial-api.onrender.com/api
VITE_API_URL=

# Socket.IO base URL
# Local dev fallback is http://localhost:3000
# Render example: https://pollamundial-api.onrender.com
VITE_SOCKET_URL=
